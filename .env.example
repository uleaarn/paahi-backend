# Restaurant Voice Agent configuration

# Required: chat model API key. Defaults to DeepSeek via the OpenAI-compatible SDK.
OPENAI_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Required: Deepgram API Key for Speech-to-Text
# Get it from: https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Required for Text-to-Speech: Google Cloud credentials.
# For Railway/deployments, paste the whole service-account JSON into this env var.
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
GOOGLE_TTS_LANGUAGE=en-US
GOOGLE_TTS_VOICE=en-US-Neural2-D

# Optional: restaurant identity. data/menu.json is still the menu source of truth.
RESTAURANT_NAME=Your Restaurant
RESTAURANT_LOCATION=123 Main St, Your City, ST
RESTAURANT_PHONE=(555) 123-4567
AGENT_NAME=Restaurant AI
INITIAL_GREETING=Hello! Thank you for calling Your Restaurant. How can I help you today?

# Optional: n8n Webhook URL for order submission
# Example: https://your-n8n-instance.com/webhook/restaurant-orders
N8N_WEBHOOK_URL=your_n8n_webhook_url_here

# Optional: Server port (default: 3000)
PORT=3000

# Optional: Twilio Account SID (for reference)
TWILIO_ACCOUNT_SID=your_twilio_account_sid

# Optional: Twilio Auth Token (for reference)
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Optional: Twilio Phone Number (for reference)
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Email Notifications (for order confirmations)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_TO=orders@example.com

# Analytics Configuration (optional)
ANALYTICS_LOG_DIR=./logs
ANALYTICS_RETENTION_DAYS=30
