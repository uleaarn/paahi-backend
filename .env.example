# Paahi voice agent — server configuration (names and descriptions only; never commit real values)
#
# Business-specific settings (name, hours, menu, languages, phone numbers, workflows)
# live in businesses/<business-id>/business.json, not here. A business.json refers to
# its secrets by environment variable NAME (fields ending in "_env"), so the values
# below stay on the server.

# --- Language model (required). DeepSeek by default, through the OpenAI-compatible SDK.
OPENAI_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# Max time to wait for the model on one turn (milliseconds)
LLM_TIMEOUT_MS=10000

# --- Database (required): Supabase Postgres, connected as the paahi_app role. See docs/DATABASE.md
DATABASE_URL=postgresql://paahi_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Optional: the project's SSL certificate (PEM text) so the server certificate is verified
DATABASE_CA_CERT=

# --- Speech to text (required). https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key_here
# nova-3 is needed for Telugu and for multi-language businesses (they always use nova-3).
DEEPGRAM_MODEL=nova-3

# --- Text to speech. English is spoken by Deepgram Aura using DEEPGRAM_API_KEY above.
# Optional: Google Cloud service-account JSON, needed only for Spanish/French/Hindi/Telugu
# (and used as a backup voice for English). The Google project must have billing enabled.
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# --- Call routing
# Calls are routed by the number dialed (phone_numbers in each business.json).
# For a single-business deployment you can instead send every call to one business:
DEFAULT_BUSINESS_ID=jalwa-montclair

# --- Order and callback notifications (sent after the order is saved; at least one per ordering business)
# Sending account for all businesses (Gmail app password).
# Staff email. On Railway Hobby, outgoing SMTP (Gmail) is blocked: use Resend.
# Resend (https://resend.com): an API key; without a verified domain it can only
# send from onboarding@resend.dev to your own Resend account email.
RESEND_API_KEY=
RESEND_FROM=
# Gmail SMTP (used only when RESEND_API_KEY is empty; needs a host that allows SMTP)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
# Per-business recipients. Jalwa's business.json says: "email_to_env": "EMAIL_TO".
EMAIL_TO=orders@example.com
# Optional: a business can also name a webhook variable in business.json ("webhook_url_env").
# Jalwa uses email only.

# --- Admin
# Bearer token for /analytics/* (call records contain customer details). Unset = endpoints disabled.
ADMIN_API_TOKEN=

# --- Server
PORT=3000
ANALYTICS_LOG_DIR=./logs
ANALYTICS_RETENTION_DAYS=30

# --- Twilio (reference only; not read by the server yet)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# --- TESTING ONLY. Leave false in production.
# Take orders outside the opening hours in business.json
ALLOW_ORDERS_WHEN_CLOSED=false
